# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# En production (Vercel) : https://atelier-sigma-pink.vercel.app
APP_URL="http://localhost:3000"

# ==============================================================================
# WOOCOMMERCE & WORDPRESS CONFIGURATION
# ==============================================================================
# URL racine de votre installation WordPress locale ou distante avec WooCommerce
# Exemple local : http://localhost/wordpress ou http://localhost:8080
# Exemple distant : https://votreboutique.com
WC_URL="http://localhost/wordpress"

# Clés d'API REST WooCommerce (Générées dans WooCommerce > Réglages > Avancé > API REST)
# Droits requis : Lecture / Écriture (Read/Write)
WC_CONSUMER_KEY="ck_your_consumer_key_here"
WC_CONSUMER_SECRET="cs_your_consumer_secret_here"

# WooCommerce API Version (v3 recommandé pour WooCommerce 7.x / 8.x / 9.x)
WC_API_VERSION="wc/v3"

# ==============================================================================
# SÉCURITÉ DU DASHBOARD ADMIN ATELIER
# ==============================================================================
# Identifiants de connexion au dashboard administratif (/admin)
ADMIN_EMAIL="admin@atelier-paris.com"
ADMIN_PASSWORD="atelier_secure_admin_2026"
ADMIN_SESSION_SECRET="atelier_jwt_secret_key_change_in_production"

# ==============================================================================
# CONFIGURATION STRIPE (MODE TEST UNIQUEMENT)
# ==============================================================================
# Clé secrète de test Stripe (commence par sk_test_...) - Utilisée UNIQUEMENT côté serveur
# ⚠️  NE JAMAIS committer cette valeur. Sur Vercel, la définir dans
#     Settings > Environment Variables (Production + Preview). Elle est lue
#     exclusivement dans server.ts / api/index.ts (jamais exposée au navigateur).
STRIPE_SECRET_KEY=""

# Clé publique de test Stripe (commence par pk_test_...)
# Peut être exposée au navigateur (elle est renvoyée par /api/stripe/config).
STRIPE_PUBLISHABLE_KEY=""

# Secret de signature des webhooks Stripe (commence par whsec_...)
# Configurer l'endpoint webhook : http://localhost:3000/api/stripe/webhook
# En production : https://atelier-sigma-pink.vercel.app/api/stripe/webhook
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_signing_secret_here"

# ==============================================================================
# DÉPLOIEMENT VERCEL (variables d'environnement du projet Vercel)
# ==============================================================================
# Le back-end Express est déployé comme Serverless Function (dossier /api).
# Ces variables doivent être définies dans le tableau de bord Vercel :
#   Project Settings > Environment Variables
#
#   STRIPE_SECRET_KEY      = sk_test_...      (Secret, Production + Preview)
#   STRIPE_PUBLISHABLE_KEY = pk_test_...      (Production + Preview)
#   STRIPE_WEBHOOK_SECRET  = whsec_...        (Production)
#   APP_URL                = https://atelier-sigma-pink.vercel.app
#   ADMIN_EMAIL / ADMIN_PASSWORD / ADMIN_SESSION_SECRET (dashboard /admin)
#   WC_URL / WC_CONSUMER_KEY / WC_CONSUMER_SECRET (si WooCommerce est utilisé)
#
# Le fichier .env est ignoré par git (.gitignore) : il sert uniquement au
# développement local. Ne jamais pousser une clé secrète sur GitHub.

